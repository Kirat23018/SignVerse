# SignVerse Server-Side Environment Variables
# IMPORTANT: Never prefix secret API keys with VITE_ (VITE_ variables are bundled into public frontend JS).
# Configure these in Vercel Project Settings -> Environment Variables for the /api/chat serverless proxy.

# Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# FastAPI Backend Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://sign-verse-tau.vercel.app
